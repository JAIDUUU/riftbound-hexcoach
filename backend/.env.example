# Copy to .env (gitignored) and fill in. Never commit real values.

# Supabase Postgres (use the session pooler string if the direct connection is IPv6-only)
DATABASE_URL=

# Chat model providers (fallback chain: Gemini -> Groq -> OpenRouter)
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Langfuse tracing and evals
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
