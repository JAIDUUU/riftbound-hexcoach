# Copy to .env (gitignored) and fill in. Never commit real values.

# Supabase Postgres (use the session pooler string if the direct connection is IPv6-only)
DATABASE_URL=

# Supabase project URL (https://<project-ref>.supabase.co). Not a secret: the API uses it
# to fetch the project's public JWKS and verify sign-in tokens.
SUPABASE_URL=

# Browser origins allowed to call the API (comma-separated; empty allows none).
# Dev frontend: http://localhost:5173. Deployed: the frontend's public origin.
CORS_ALLOWED_ORIGINS=

# Input caps (optional; defaults 4000 characters per message, 20 messages of history,
# 10 @ mentions per message, 4000 characters per decklist). UNVERIFIED placeholders until
# the free-tier limits are checked.
MAX_MESSAGE_CHARS=
MAX_HISTORY_MESSAGES=
MAX_MENTIONS=
MAX_DECKLIST_CHARS=

# Per-player message limits (optional; defaults 5 per minute, per API process, and 50 per
# UTC day, counted in Postgres). UNVERIFIED placeholders until the free-tier limits are checked.
MESSAGES_PER_MINUTE=
MESSAGES_PER_DAY=

# Chat model providers (fallback chain: Gemini -> Groq -> OpenRouter).
# Providers without a key are skipped.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Override the chain (comma-separated provider:model entries; order matters).
# Default: gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
LLM_PROVIDER_CHAIN=

# Langfuse tracing and evals
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
